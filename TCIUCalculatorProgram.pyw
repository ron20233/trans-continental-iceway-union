import tkinter

icon = ""

root = tkinter.Tk()
startXVari = tkinter.StringVar()
startZVari = tkinter.StringVar()
endXVari = tkinter.StringVar()
endZVari = tkinter.StringVar()
storedTick = tkinter.IntVar()
photoImg = tkinter.PhotoImage(data=icon)
root.geometry('400x150+800+100')
root.title("TCIU Nether Coordinate Tool")
root.iconphoto(True, photoImg)
startXLabel = tkinter.Label(root, text="Start X: ").grid(row=0, column=0, sticky="w")
startX = tkinter.Entry(root, textvariable=startXVari, width=9).grid(row=0, column=1)
startZLabel = tkinter.Label(root, text="Start Z: ").grid(row=0, column=2, sticky="w")
startZ = tkinter.Entry(root, textvariable=startZVari, width=9).grid(row=0, column=3)
endXLabel = tkinter.Label(root, text="End X: ").grid(row=1, column=0, sticky="w")
endX = tkinter.Entry(root, textvariable=endXVari, width=9).grid(row=1, column=1)
endZLabel = tkinter.Label(root, text="End Z: ").grid(row=1, column=2, sticky="w")
endZ = tkinter.Entry(root, textvariable=endZVari, width=9).grid(row=1, column=3)
offsetTick = tkinter.Checkbutton(root, text="Disable offset? (not recommended)", variable=storedTick).grid(row=2, column=0, columnspan=4, sticky="w")
submit = tkinter.Button(root, text="Submit coordinates", command= lambda: calculator(startXVari.get(), startZVari.get(), endXVari.get(), endZVari.get(), storedTick.get())).grid(row=3, column=0, columnspan=4, sticky="w")
outputLabel = tkinter.Label(root, text="")
outputLabel.grid(row=4, column=0, columnspan=4, sticky="w")

def calculator(startXInput, startZInput, endXInput, endZInput, hundredOffset):
    offset = 0
    xPos = None
    zPos = None

    if hundredOffset == 0:
        offset = -100

    try:
        startXCoord = round((float(startXInput) + offset) / 8)
        startZCoord = round((float(startZInput) + offset) / 8)
        xCoord = round((float(endXInput) + offset) / 8)
        zCoord = round((float(endZInput) + offset) / 8)
    except ValueError:
        outputLabel.config(text="Please enter numbers in all four boxes.")
        return

    xDiff = abs(startXCoord - xCoord)
    if xDiff <= 35:
        xPos = "Branch"
    elif startXCoord < xCoord:
        xPos = f"R-{xDiff}"
    else:
        xPos = f"L-{xDiff}"

    zDiff = abs(startZCoord - zCoord)
    if zDiff <= 35:
        zPos = "Branch"
    elif startZCoord < zCoord:
        zPos = f"D-{zDiff}"
    else:
        zPos = f"U-{zDiff}"

    global finStringWithCoords

    finStringWithCoords = f"Nether: ({xCoord}, {zCoord}) ({xPos}, {zPos})"
    startXVari.set("")
    startZVari.set("")
    endXVari.set("")
    endZVari.set("")

    outputLabel.config(text=finStringWithCoords)

root.mainloop()